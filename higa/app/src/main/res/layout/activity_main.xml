<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/dniInput"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:gravity="top"
        android:hint="Pegá varios DNI, uno por línea"
        android:inputType="textMultiLine"
        android:imeOptions="flagNoEnterAction"
        android:singleLine="false" />

    <EditText
        android:id="@+id/fromDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha desde (dd/mm/aaaa)" />

    <EditText
        android:id="@+id/toDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fecha hasta (dd/mm/aaaa)" />

    <Button
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar consultas" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Siguiente DNI"
        android:enabled="false" />

    <Button
        android:id="@+id/pdfListButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PDF descargados" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal"
        android:visibility="visible" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Listo" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <Button
        android:id="@+id/closePdfButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver a las consultas"
        android:visibility="gone" />

    <FrameLayout
    android:id="@+id/pdfContainer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:visibility="gone" />


    <LinearLayout
        android:id="@+id/pdfListContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/closePdfListButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver a las consultas" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TableLayout
                    android:id="@+id/pdfTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Textos extraídos"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:padding="12dp" />

                <TableLayout
                    android:id="@+id/resultsTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*" />
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Resultados de análisis"
    android:textStyle="bold"
    android:textSize="18sp"
    android:padding="12dp" />

<Button
    android:id="@+id/downloadResultsButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Descargar resultados CSV" />

<HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TableLayout
        android:id="@+id/determinationsTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:stretchColumns="*" />

</HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
